{
  "name": "mediavault",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Privacy-first Chrome extension for saving media you are authorized to access from Instagram, Facebook, and TikTok.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -k -n pages,content \"vite build --watch\" \"vite build --config vite.content.config.ts --watch\"",
    "build": "npm run typecheck && vite build && vite build --config vite.content.config.ts && npm run verify:dist",
    "build:pages": "vite build",
    "build:content": "vite build --config vite.content.config.ts",
    "verify:dist": "node scripts/verify-dist.mjs",
    "check": "npm run lint && npm run test:run && npm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "test": "NODE_ENV=test vitest",
    "test:run": "NODE_ENV=test vitest run",
    "lint": "eslint .",
    "format": "prettier --write .",
    "icons": "node scripts/generate-icons.mjs"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "idb": "^8.0.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@tailwindcss/vite": "^4.0.0",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/chrome": "^0.0.287",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "fake-indexeddb": "^6.0.0",
    "jsdom": "^25.0.1",
    "prettier": "^3.4.2",
    "prettier-plugin-tailwindcss": "^0.6.9",
    "sharp": "^0.33.5",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0",
    "vite": "^6.0.5",
    "vitest": "^3.0.0"
  }
}
